# ===== DEEVUH — Environment Configuration =====
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git (already gitignored).

# --- Supabase (from https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SECRET — service role key (full DB access). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- PayU Payment Gateway (client id / key aap provide karoge) ---
PAYU_MERCHANT_KEY=YOUR-MERCHANT-KEY
PAYU_SALT=YOUR-MERCHANT-SALT
# 'test' for sandbox (test.payu.in), 'live' for production (secure.payu.in)
PAYU_ENV=test

# --- Site URL (real domain once set — used for PayU redirects + metadata) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend - https://resend.com) ---
RESEND_API_KEY=re_YOUR_KEY
RESEND_DOMAIN=confirmation.deevuh.in